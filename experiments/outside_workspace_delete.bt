// 实验⑤c：Agent 1 只允许删除 /tmp/ebpf-exp5-delete/workspace/ 内的文件。
// 启动器准备和清理夹具，自身不登记为 Agent。
BEGIN
{
    printf("event=launcher pid=%d policy=workspace_delete_only workspace=/tmp/ebpf-exp5-delete/workspace/\n",
           cpid);
}

// 启动器的直接孩子登记为 Agent 1；后代继续继承标签。
tracepoint:sched:sched_process_fork
/(uint32)args->parent_pid == cpid || @agent[args->parent_pid]/
{
    if ((uint32)args->parent_pid == cpid) {
        @agent[args->child_pid] = 1;
        printf("mono_ns=%llu event=register root_pid=%d agent_id=1 basis=launcher_fork\n",
               nsecs, args->child_pid);
    } else {
        @agent[args->child_pid] = @agent[args->parent_pid];
        printf("mono_ns=%llu event=fork parent_pid=%d child_pid=%d agent_id=%d basis=fork\n",
               nsecs, args->parent_pid, args->child_pid, @agent[args->child_pid]);
    }
}

// Linux unlink 系统调用入口：保存测试根目录内的路径和入口时间。
tracepoint:syscalls:sys_enter_unlink
/@agent[tid]/
{
    $name = str(args->pathname);
    if (strncmp($name, "/tmp/ebpf-exp5-delete/", 22) == 0) {
        @path[tid] = $name;
        @started[tid] = nsecs;
        // outside 子目录位于允许工作区之外。
        @outside[tid] = strncmp($name, "/tmp/ebpf-exp5-delete/outside/", 30) == 0;
    }
}

// Linux unlink 返回点：输出删除结果，成功删除 outside 文件时告警。
tracepoint:syscalls:sys_exit_unlink
/@started[tid]/
{
    printf("mono_ns=%llu enter_ns=%llu event=unlink_result pid=%d tid=%d agent_id=%d filename=%s ret=%lld outside_workspace=%d basis=tracked_task\n",
           nsecs, @started[tid], pid, tid, @agent[tid], @path[tid],
           args->ret, @outside[tid]);

    if (@outside[tid] && args->ret == 0) {
        printf("mono_ns=%llu event=security_alert severity=high rule=outside_workspace_delete pid=%d tid=%d agent_id=%d target=%s ret=%lld outcome=success policy=workspace_delete_only workspace=/tmp/ebpf-exp5-delete/workspace/ evidence=unlink_result,path_policy,process_tree_attribution\n",
               nsecs, pid, tid, @agent[tid], @path[tid], args->ret);
    }

    delete(@path[tid]);
    delete(@started[tid]);
    delete(@outside[tid]);
}

tracepoint:sched:sched_process_exit
/@agent[tid]/
{
    printf("mono_ns=%llu event=exit pid=%d tid=%d agent_id=%d\n",
           nsecs, pid, tid, @agent[tid]);
    delete(@agent[tid]);
    delete(@path[tid]);
    delete(@started[tid]);
    delete(@outside[tid]);
}

END
{
    clear(@agent);
    clear(@path);
    clear(@started);
    clear(@outside);
}
