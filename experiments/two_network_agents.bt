// 实验④b：观察两组 Agent 各自的 IPv4 connect，检查网络事件归属。
struct exp4_sockaddr_in {
    unsigned short family;
    unsigned char port_hi;
    unsigned char port_lo;
    unsigned int address;
    unsigned char padding[8];
};

// 启动器本身不是 Agent；它创建的前两个孩子依次登记为 Agent 1、2。
BEGIN
{
    @next_agent = 0;
    printf("event=launcher pid=%d\n", cpid);
}

tracepoint:sched:sched_process_fork
/(uint32)args->parent_pid == cpid || @agent[args->parent_pid]/
{
    if ((uint32)args->parent_pid == cpid) {
        @next_agent = @next_agent + 1;
        @agent[args->child_pid] = @next_agent;
        printf("mono_ns=%llu event=register root_pid=%d agent_id=%d basis=launcher_fork_order\n",
               nsecs, args->child_pid, @agent[args->child_pid]);
    } else {
        @agent[args->child_pid] = @agent[args->parent_pid];
        printf("mono_ns=%llu event=fork parent_pid=%d child_pid=%d agent_id=%d basis=fork\n",
               nsecs, args->parent_pid, args->child_pid, @agent[args->child_pid]);
    }
}

// connect 入口：按 TID 保存 IPv4 目标、fd 和入口时间。
tracepoint:syscalls:sys_enter_connect
/@agent[tid]/
{
    if (args->addrlen >= 16) {
        $addr = (struct exp4_sockaddr_in *)uptr(args->uservaddr);
        if ($addr->family == 2) {
            @address[tid] = $addr->address;
            @port[tid] = (uint64)$addr->port_hi * 256 + (uint64)$addr->port_lo;
            @fd[tid] = args->fd;
            @started[tid] = nsecs;
        }
    }
}

// connect 返回：输出归属和目标，随后清理本次配对记录。
tracepoint:syscalls:sys_exit_connect
/@started[tid]/
{
    printf("mono_ns=%llu enter_ns=%llu event=connect_result pid=%d tid=%d agent_id=%d fd=%d family=2 dst_ip=%s dst_port=%llu ret=%lld basis=tracked_task\n",
           nsecs, @started[tid], pid, tid, @agent[tid], @fd[tid],
           ntop(2, (uint32)@address[tid]), @port[tid], args->ret);
    delete(@address[tid]);
    delete(@port[tid]);
    delete(@fd[tid]);
    delete(@started[tid]);
}

tracepoint:sched:sched_process_exit
/@agent[tid]/
{
    printf("mono_ns=%llu event=exit pid=%d tid=%d agent_id=%d\n",
           nsecs, pid, tid, @agent[tid]);
    delete(@agent[tid]);
    delete(@address[tid]);
    delete(@port[tid]);
    delete(@fd[tid]);
    delete(@started[tid]);
}

END
{
    clear(@agent);
    clear(@address);
    clear(@port);
    clear(@fd);
    clear(@started);
    clear(@next_agent);
}
