// Experiment 3a: openat entry/exit pairing for private test paths.
// Keys are task IDs (TIDs); these equal PIDs in this workload. Agent 1 = A.
BEGIN
{
    @agent[cpid] = 1;
    printf("event=register root_pid=%d agent_id=1 basis=launch\n", cpid);
}

tracepoint:sched:sched_process_fork
/@agent[args->parent_pid]/
{
    @agent[args->child_pid] = @agent[args->parent_pid];
    printf("mono_ns=%llu event=fork parent_pid=%d child_pid=%d agent_id=%d basis=fork\n",
           nsecs, args->parent_pid, args->child_pid, @agent[args->child_pid]);
}

// Keep only this experiment's absolute paths to avoid Python startup noise.
tracepoint:syscalls:sys_enter_openat
/@agent[tid]/
{
    $name = str(args->filename);
    if (strncmp($name, "/tmp/ebpf-exp3-", 15) == 0) {
        @path[tid] = $name;
        @started[tid] = nsecs;
        @flags[tid] = args->flags;
    }
}

tracepoint:syscalls:sys_exit_openat
/@started[tid]/
{
    printf("mono_ns=%llu enter_ns=%llu event=openat_result pid=%d tid=%d agent_id=%d filename=%s flags=%d ret=%lld basis=tracked_task\n",
           nsecs, @started[tid], pid, tid, @agent[tid], @path[tid], @flags[tid], args->ret);
    delete(@path[tid]);
    delete(@started[tid]);
    delete(@flags[tid]);
}

tracepoint:sched:sched_process_exit
/@agent[tid]/
{
    printf("mono_ns=%llu event=exit pid=%d tid=%d agent_id=%d\n",
           nsecs, pid, tid, @agent[tid]);
    delete(@agent[tid]);
    delete(@path[tid]);
    delete(@started[tid]);
    delete(@flags[tid]);
}

END
{
    clear(@agent);
    clear(@path);
    clear(@started);
    clear(@flags);
}
