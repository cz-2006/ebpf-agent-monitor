// 实验⑤a：策略规定 Agent 1 不允许启动 /bin/sh 或 /bin/bash。
// 这里只判断 execve 尝试；是否执行成功由受控工作负载的退出码辅助核对。
BEGIN
{
    @agent[cpid] = 1;
    printf("event=register root_pid=%d agent_id=1 policy=shell_denied basis=launch\n",
           cpid);
}

// 子任务继承父任务的 Agent 标签。
tracepoint:sched:sched_process_fork
/@agent[args->parent_pid]/
{
    @agent[args->child_pid] = @agent[args->parent_pid];
    printf("mono_ns=%llu event=fork parent_pid=%d child_pid=%d agent_id=%d basis=fork\n",
           nsecs, args->parent_pid, args->child_pid, @agent[args->child_pid]);
}

tracepoint:syscalls:sys_enter_execve
/@agent[tid]/
{
    $name = str(args->filename);
    printf("mono_ns=%llu event=execve_attempt pid=%d tid=%d agent_id=%d filename=%s basis=tracked_task\n",
           nsecs, pid, tid, @agent[tid], $name);

    // 比较长度包含字符串末尾的 NUL，避免把 /bin/shadow 等误判为 Shell。
    if (strncmp($name, "/bin/sh", 8) == 0 ||
        strncmp($name, "/bin/bash", 10) == 0) {
        printf("mono_ns=%llu event=security_alert severity=high rule=unexpected_shell pid=%d tid=%d agent_id=%d target=%s policy=shell_denied evidence=execve_attempt,process_tree_attribution\n",
               nsecs, pid, tid, @agent[tid], $name);
    }
}

tracepoint:sched:sched_process_exit
/@agent[tid]/
{
    printf("mono_ns=%llu event=exit pid=%d tid=%d agent_id=%d\n",
           nsecs, pid, tid, @agent[tid]);
    delete(@agent[tid]);
}

END
{
    clear(@agent);
}
